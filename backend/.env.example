DATABASE_URL=postgresql://postgres:postgres@localhost:5432/codeatlas
JWT_SECRET=supersecretjwtkeyplaceholderchangeinproduction
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_REDIRECT_URI=http://localhost:8000/v1/auth/github/callback
REPO_STORAGE_PATH=./repos
OPENAI_API_KEY=your_openai_api_key

# Embedding Provider Configuration
# Supported values: ollama, openai
EMBEDDING_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
# Note: For Ollama, the recommended model is nomic-embed-text. Make sure to pull it using `ollama pull nomic-embed-text`

QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=your_qdrant_api_key
